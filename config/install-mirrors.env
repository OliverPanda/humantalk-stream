# Default download sources. Existing environment variables take precedence.
# Set FREEVIDEOAI_DOWNLOAD_SOURCE=official to skip these defaults.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_PYTHON_INSTALL_MIRROR=https://mirror.nju.edu.cn/github-release/astral-sh/python-build-standalone
FREEVIDEOAI_TORCH_INDEX=https://mirror.sjtu.edu.cn/pytorch-wheels
FREEVIDEOAI_GITHUB_MIRROR=https://ghfast.top/https://github.com
FREEVIDEOAI_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_DISABLE_XET=1
PIP_TIMEOUT=120
PIP_RETRIES=5
UV_HTTP_TIMEOUT=120
UV_HTTP_RETRIES=5
PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright
# No verified drop-in public mirror for these pinned MMCV wheels.
FREEVIDEOAI_MMCV_INDEX=https://download.openmmlab.com/mmcv/dist/cu118/torch2.0/index.html
