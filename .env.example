# FreeVideoAI Pro：仅 DeepSeek Chat 使用远端 API，其余模型本地运行。
# 复制为 .env 后填写，或在网页“模型配置 → LLM”保存。
# .env 已被 Git 忽略，请勿提交真实密钥。
KRVOICEAI_LLM_API_KEY=

# 默认 DeepSeek 官方地址；如使用兼容代理，可在网页修改地址。
# KRVOICEAI_LLM_BASE_URL=https://api.deepseek.com/v1

# 环境变量优先于网页和 user_config.yaml。
# 请勿保留旧的 TTS_PROVIDER、AVATAR_PROVIDER 或模型路径覆盖项。
# 模型和独立 Python 路径由 Pro 安装器写入 config/user_config.yaml。
